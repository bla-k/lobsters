# Copy to .env on the VPS, fill in values, chmod 600. Do not commit the copy.
#
#   cp .env.example .env
#   chmod 600 .env

# MariaDB credentials. Use different strong values for each.
#   generate with: openssl rand -hex 32
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Rails secret key base.
#   generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Rails master key for config/credentials.yml.enc.
# If you don't use encrypted credentials yet, put any 32-hex value here.
#   generate with: openssl rand -hex 16
RAILS_MASTER_KEY=

# Cloudflare Tunnel token from the Zero Trust dashboard.
CF_TUNNEL_TOKEN=

# SMTP settings for outbound mail. Used by config/initializers/production.rb.
# The four below are required — Rails boot fails if any are missing.
# (The From: header is set by ApplicationMailer, not here.)
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USER_NAME=
SMTP_PASSWORD=

# Optional SMTP tuning — leave blank to accept the defaults in the comments.
SMTP_DOMAIN=           # default: Rails.application.domain (hackt.news)
SMTP_AUTHENTICATION=   # default: login  (also: plain, cram_md5)
SMTP_STARTTLS_AUTO=    # default: true
SMTP_OPEN_TIMEOUT=     # default: 10 (seconds)
SMTP_READ_TIMEOUT=     # default: 10 (seconds)
