# Copy to .env on the VPS, fill in values, chmod 600. Do not commit the copy.
#
#   cp .env.example .env
#   chmod 600 .env

# MariaDB credentials. Use different strong values for each.
#   generate with: openssl rand -hex 32
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Rails secret key base.
#   generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Rails master key for config/credentials.yml.enc.
# If you don't use encrypted credentials yet, put any 32-hex value here.
#   generate with: openssl rand -hex 16
RAILS_MASTER_KEY=

# Cloudflare Tunnel token from the Zero Trust dashboard.
CF_TUNNEL_TOKEN=
