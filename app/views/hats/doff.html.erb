<%= form_with url: doff_by_user_hat_path(@hat) do |f| %>
  <div class="hackt-form-grid">
    <%= f.label :user_id, "User" %>
    <span><%= styled_user_link @hat.user %></span>

    <%= f.label :hat, "Hat" %>
    <span><%= styled_hat(@hat) %></span>

    <%= f.label :reason, "Reason" %>
    <%= f.text_field :reason %>
    <div class="hackt-form-grid__note hint">
      Short public explanation, like "Left project"
    </div>
  </div>

  <%= submit_tag "Doff Hat" %>
<% end %>
