<%# locals: (f:) -%>

<%= f.label :tags, "Tags" %>
<%= f.select "tags",
  options_for_select(
    Tag.all_with_filtered_counts_for(@user).map { |t|
      html = "<strong>#{h(t.tag)}</strong> - #{h(t.description.to_s)}"

      if t.hotness_mod != 0
        html << " (hotness mod #{t.hotness_mod > 0 ? "+" : ""}#{t.hotness_mod})"
      end

      if t.filtered_count > 0
        html <<
          " <em>#{t.filtered_count} user" <<
          (t.filtered_count == 1 ? "" : "s") <<
          " filtering</em>"
      end

      [
        "#{t.tag} - #{t.description}",
        t.tag,
        {
          "data-title" => raw(html),
          "data-tag-css" => t.css_class,
          "data-vibe" => (t.tag == "vibecoding") ? 'ai' : ''
        }
      ]
    },
    f.object.tags.map(&:tag)
  ),
  {},
  { multiple: true, required: true }
%>

