<%# locals: (allow_images: false, class_name: nil) -%>

<details class="<%= class_names("markdown_help", class_name) %>">
  <summary>Markdown formatting available</summary>
  <dl class="markdown_help__grid">
    <dt><em>emphasized text</em></dt>
    <dd>surround text with <code>*asterisks*</code></dd>

    <dt><strong>strong text</strong></dt>
    <dd>surround text with <code>**two asterisks**</code></dd>

    <dt><strike>struck-through</strike></dt>
    <dd>surround text with <code>~~two tilde characters~~</code></dd>

    <dt><code>fixed width</code></dt>
    <dd>surround text with <code>`backticks`</code></dd>

    <dt><a href="http://example.com/" style="color: inherit;">linked text</a></dt>
    <dd><code>[linked text](http://example.com/)</code> or just a bare URL to create without a title</dd>

    <dt><blockquote>quoted text</blockquote></dt>
    <dd>prefix text with <code>&gt;</code></dd>

    <dt><pre style="margin: 0px;">pre text</pre></dt>
    <dd>prefix text with at least <code>&nbsp;&nbsp;&nbsp;&nbsp;4 spaces</code></dd>

    <dt>@ or ~</dt>
    <dd>Refer to users by prefixing their username with a @ or tilde</dd>

    <% if allow_images %>
      <dt>(inline image)</dt>
      <dd><code>![alt text](http://example.com/image.jpg)</code></dd>
    <% end %>
  </dl>
</details>
