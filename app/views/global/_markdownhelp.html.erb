<%# locals: (allow_images: false, class_name: nil) -%>

<details class="<%= class_names("markdown_help", class_name) %>">
  <summary>Markdown formatting available</summary>
  <dl class="markdown_help__grid">
    <dt><em>emphasized text</em></dt>
    <dd>surround text with <tt>*asterisks*</tt></dd>

    <dt><strong>strong text</strong></dt>
    <dd>surround text with <tt>**two asterisks**</tt></dd>

    <dt><strike>struck-through</strike></dt>
    <dd>surround text with <tt>~~two tilde characters~~</tt></dd>

    <dt><tt>fixed width</tt></dt>
    <dd>surround text with <tt>`backticks`</tt></dd>

    <dt><a href="http://example.com/" style="color: inherit;">linked text</a></dt>
    <dd><tt>[linked text](http://example.com/)</tt> or just a bare URL to create without a title</dd>

    <dt><blockquote>quoted text</blockquote></dt>
    <dd>prefix text with <tt>&gt;</tt></dd>

    <dt><pre style="margin: 0px;">pre text</pre></dt>
    <dd>prefix text with at least <tt>&nbsp;&nbsp;&nbsp;&nbsp;4 spaces</tt></dd>

    <dt>@ or ~</dt>
    <dd>Refer to users by prefixing their username with a @ or tilde</dd>

    <% if allow_images %>
      <dt>(inline image)</dt>
      <dd><tt>![alt text](http://example.com/image.jpg)</tt></dd>
    <% end %>
  </dl>
</details>
