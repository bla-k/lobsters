<div id="domain_box" class="box wide">
  <h1><%= "New domain" if @domain.new_record? %> <%= @domain.domain %></h1>

  <%= form_with model: [:mod, @domain] do |f| %>
    <%= errors_for @domain %>

    <%= hidden_field_tag :new_domain, @domain.domain || params[:id] %>
    <div class="hackt-form-grid">
      <%= f.label :selector, "Origin selector" %>
      <%= f.text_field :selector, autocapitalize: :off %>
      <div class="hackt-form-grid__note">Regexp with captures, must consume whole string like: <code>\Ahttps?://github.com/+([^/]+).*\z</code></div>

      <%= f.label :replacement, "Origin replacement" %>
      <%= f.text_field :replacement, autocapitalize: :off %>
      <div class="hackt-form-grid__note"><code>github.com/\1</code></div>
    </div>

    <%= f.submit 'Save' %>
  <% end %>

  <br><br><hr><br>

  <%= form_with model: @domain, url: @domain.new_record? ? mod_create_and_ban_domain_path(id: @domain.domain) : mod_ban_domain_path(id: @domain.domain) do |f| %>
    <%= hidden_field_tag :new_domain, @domain.new_record? %>

    <div class="hackt-form-grid">
      <% if @domain.banned_at %>
        <label>Status</label>
        <span>Banned</span>

        <label>Banned Reason</label>
        <span>
          <%= @domain.banned_reason %>
        </span>

        <label>Banned At</label>
        <span>
          <%= @domain.banned_at %>
        </span>

        <label>Banned by User</label>
        <span>
          <%= @domain.banned_by_user.username %>
        </span>
      <% end %>

      <%= f.label :banned_reason, "#{caption_of_button(@domain)} Reason" %>
      <%= f.text_field :banned_reason, required: true, value: '' %>
    </div>

    <%= f.submit caption_of_button(@domain), class: 'deletion' %>
  <% end %>
</div>
