<section>
  <%= form_with model: @edit_user, url: deactivate_path, method: :post, id: 'deactivate_user', namespace: 'deactivate_user' do |f| %>
    <h2>Deactivate Account</h2>
    <p>
    To deactivate your account, verify your current password below.
    </p>
    <ul>
      <li>Your profile will show that you deactivated your account.</li>
      <li>You will not be able to log in, but you can reset your password if you want to reactivate your account.</li>
      <li>Your username will remain reserved and will not be available for any other account.</li>
      <li>Your private messages will be deleted (recipients will keep their copies of messages).</li>
      <li>Your submitted stories will not be deleted.</li>
      <li>
        Your comments with negative scores will be deleted, and you can check "disown comments"
        below if you want all of your stories and comments to change to list
        <a href="/~inactive-user">inactive-user</a> instead of your username.
      </li>
    </ul>

    <div class="labelled_grid">
      <%= f.label :password, "Verify Password" %>
      <%= f.password_field :password, required: true, autocomplete: "off" %>
      <%= f.label :i_am_sure, "I am sure", class: "for_checkbox" %>
      <span><%= f.check_box :i_am_sure, required: true %></span>
      <%= f.label :disown, "Disown stories/comments", :class => "for_checkbox" %>
      <span><%= f.check_box :disown %> <span class="hint">(optional)</span></span>
    </div>

    <%= f.submit "Yes, Deactivate My Account", :class => "deletion" %>
  <% end %>
</section>
