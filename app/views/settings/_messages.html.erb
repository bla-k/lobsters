<%# locals: (f:) -%>
<section>
  <h3>Private Message Notifications</h3>

  <div class="hackt-form-grid hackt-form-grid--inline">
    <span><%= f.check_box :email_messages %></span>
    <%= f.label :email_messages, "Receive E-mail" %>

    <% if Pushover.enabled? %>
      <span>
        <%= f.check_box :pushover_messages %>
        <span class="hint">
          Requires Pushover subscription below
        </span>
      </span>
      <%= f.label :pushover_messages, "Receive Pushover Alert" %>
    <% end %>
  </div>
</section>
