<% content_for :subnav do %>
  <%= link_to 'Public Profile', @user %>
  <a href="/filters">Filtered Tags</a> |
  <%= link_post 'Logout', logout_path, confirm: 'Are you sure you want to logout?' %>
<% end %>

<section>
  <%= form_with model: @edit_user, url: settings_path, method: :post, id: 'edit_user', namespace: 'edit_user' do |f| %>
    <%= errors_for f.object %>

    <%= render "settings/profile", f: f %>
    <%= render "settings/security", f: f %>
    <%= render "settings/replies", f: f %>
    <%= render "settings/mentions", f: f %>
    <%= render "settings/messages", f: f %>
    <%= render "settings/submitted", f: f %>
    <%= render "settings/mailing_list", f: f %>
    <%= render "settings/miscellaneous", f: f %>
  <% end %>
</section>

<%= render "settings/external_accounts" %>

<section>
  <h2 name="invite">Invite a New User</h2>

  <% if @user.can_invite? %>
    <%= render :partial => "users/invitationform" %>
  <% else %>
      You cannot send invitations: <%= @user.disabled_invite_reason %>
  <% end %>
</section>

<%= render "settings/deactivate" %>
