<%# locals: (f:) -%>
<section>
  <h3>Comment Reply Notifications</h3>

  <div class="hackt-form-grid hackt-form-grid--inline">
    <span><%= f.check_box :email_replies %></span>
    <%= f.label :email_replies, "E-mail" %>

    <% if Pushover.enabled? %>
      <span>
        <%= f.check_box :pushover_replies %>
        <span class="hint">
          * Requires Pushover subscription below
        </span>
      </span>
      <%= f.label :pushover_replies, "Pushover Alert" %>
    <% end %>

  </div>
</section>
