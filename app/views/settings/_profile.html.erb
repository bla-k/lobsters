<%# locals: (f:) -%>
<section>
  <h3>Public Profile Information</h3>

  <div class="hackt-form-grid">
    <%= f.label :username, "Username" %>
    <%= f.text_field :username, required: true, autocapitalize: :off %>
    <div class="hackt-form-grid__note hint">
      <div>Format: <code><%= Username.username_regex_s %></code></div>
      <div>Creates a <%= link_to 'modlog', moderations_path %> entry like "changed own username from '<%= @edit_user.username %>' to 'NewUsername'"</div>
    </div>

    <%= f.label :email, "Email" %>
    <%= f.email_field :email, required: true, inputmode: "email", autocapitalize: :off %>
    <% if EmailBlocklistValidation.email_on_blocklist?(@edit_user.email) %>
      <div class="hackt-form-grid__note hint">
        We don't send email to disposable email domains; change your email address.
      </div>
    <% end %>

    <%= f.label :homepage, "Homepage" %>
    <%= f.url_field :homepage, autocapitalize: :off %>
    <div class="hackt-form-grid__note hint">
      Link external accounts below
    </div>

    <%= f.label :about, "About" %>
    <%= f.text_area :about %>
    <%= render :partial => "global/markdownhelp", :locals => { class_name: "hackt-form-grid__note" } %>
  </div>
</section>
