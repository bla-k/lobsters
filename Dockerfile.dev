# Use an official Ruby image as a base
FROM ruby:4.0.0

# Install dependencies
RUN apt-get update -qq && apt-get install -y \
  build-essential \
  libjemalloc2 \
  libvips \
  mariadb-client \
  clang \
  vim

# Set working directory
WORKDIR /lobsters

# Set database hostname
ENV DATABASE_HOST db

# Install Bundler
RUN gem install bundler

# Copy Gemfile and Gemfile.lock
COPY Gemfile Gemfile.lock .ruby-version ./

# Install gems (but don't run db setup — MariaDB isn't available at build time)
RUN bundle install

# Expose port for Rails server
EXPOSE 3000

# Entrypoint: wait for DB, set up if needed, then start Rails
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
