#!/bin/bash

# DEPRECATED on the hackt.news deployment.
# The two scripts this used to background (mail_new_activity.rb and
# mastodon_post.rb) have been ported to SolidQueue recurring jobs:
#   - MailNewActivityJob  (app/jobs/mail_new_activity_job.rb)
#   - MastodonPostJob     (app/jobs/mastodon_post_job.rb)
# Both are scheduled in config/recurring.yml. Kept here for reference and for
# compatibility with upstream lobsters merges; do not invoke from our crontab.

err=0
report() {
  err=1
  echo -n "error at line ${BASH_LINENO[0]}, in call to "
  sed -n ${BASH_LINENO[0]}p $0
} >&2
trap report ERR

cd /home/deploy/lobsters/current
source /home/deploy/.asdf/asdf.sh
eval "$(/home/deploy/.asdf/bin/asdf vars)"

if [ -f public/maintenance.html ];
then
  exit 0
fi

bundle exec ruby script/mail_new_activity.rb &
bundle exec ruby script/mastodon_post.rb &

exit $err
